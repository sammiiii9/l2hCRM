# ==============================================================================
# L2H SOLUTION CRM — ENVIRONMENT CONFIGURATION (SUPABASE + VERCEL)
# ==============================================================================

# 1. SUPABASE POSTGRESQL CONNECTION STRINGS
# ------------------------------------------------------------------------------
# Go to: Supabase Dashboard -> Project Settings -> Database -> Connection string
# 
# DATABASE_URL (Transaction Pooler - Port 6543 - Recommended for Vercel Serverless):
# e.g. "postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Direct Connection - Port 5432 - Used for Prisma Migrations and Schema Push):
# e.g. "postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# 2. APPLICATION AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 64+ character secret (e.g. `openssl rand -base64 32`)
JWT_SECRET="l2h_crm_enterprise_super_secret_jwt_key_2026_production"

# 3. PUBLIC APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="L2H Solution"
NEXT_PUBLIC_APP_URL="https://your-crm-domain.vercel.app"
NODE_ENV="production"
